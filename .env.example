# FLOWZEN ENVIRONMENT CONFIGURATION
APP_NAME=Flowzen
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/flowzen/public

# DATABASE CONFIGURATION
# Connects to your existing MySQL Windows Service (MySQL267 on port 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flowzen_db
DB_USER=root
DB_PASS=YOUR_MYSQL_PASSWORD_HERE

# SESSION CONFIGURATION
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
